# Copy to web/.env for local dev (npm run dev). For the Docker build the
# root .env at the project root is used instead.
#
# When VITE_MAPBOX_TOKEN is set, all three raster basemaps (Dark, Imagery,
# Light) in the switcher use Mapbox tiles. When it is empty, the app falls
# back to anonymous Carto (Dark/Light) and EOX Sentinel-2 (Imagery).
#
# Get a free token: https://account.mapbox.com/access-tokens/
# Free tier: 50,000 tile loads per month.
#
# Security: VITE_* values are baked into the shipped JS bundle, so this
# behaves like a public API key. In your Mapbox dashboard, restrict the
# token to your deployment URLs (e.g. http://localhost:3000/*).

VITE_MAPBOX_TOKEN=

# Optional style overrides (defaults shown). One style per basemap slot.
# VITE_MAPBOX_STYLE=mapbox/satellite-streets-v12
# VITE_MAPBOX_STYLE_DARK=mapbox/dark-v11
# VITE_MAPBOX_STYLE_LIGHT=mapbox/light-v11
