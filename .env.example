# Copy to .env and adjust if needed:  cp .env.example .env

# --- PostGIS ---
POSTGRES_DB=gis
POSTGRES_USER=gis
POSTGRES_PASSWORD=change_me_pg
POSTGRES_HOST_PORT=5433

# --- GeoServer ---
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change_me_gs
GEOSERVER_WORKSPACE=ndvi_portal
GEOSERVER_HOST_PORT=8080

# --- API / Web ---
API_HOST_PORT=4000
WEB_HOST_PORT=3000
# Origin allowed to call the API directly (Vite dev server). In the Docker
# build the web app calls the API through Nginx on the same origin.
CORS_ORIGIN=http://localhost:5173

# --- Optional: Mapbox basemaps ---
# Paste your Mapbox public token (starts with pk.) below. When set, ALL
# three raster basemaps (Dark, Imagery, Light) switch from their anonymous
# defaults (Carto, EOX) to Mapbox equivalents. OSM is never overridden.
#
# Get a token: https://account.mapbox.com/access-tokens/
# Free tier: 50,000 tile loads / month, no credit card required.
#
# After setting the token, rebuild the web container so Vite bakes the
# value into the shipped JS:
#   docker compose up -d --build web
#
# Leave blank to hide Mapbox entirely; the app will keep working using the
# anonymous Carto (Dark/Light) and EOX Sentinel-2 (Imagery) endpoints.
VITE_MAPBOX_TOKEN=

# Optional style overrides (one per basemap slot). Defaults are shown.
# VITE_MAPBOX_STYLE=mapbox/satellite-streets-v12
# VITE_MAPBOX_STYLE_DARK=mapbox/dark-v11
# VITE_MAPBOX_STYLE_LIGHT=mapbox/light-v11
